# ============================================================
#  برای تست، فقط بخش ۱ و ۲ را پر کن. بقیه اختیاری است.
# ============================================================

# ---------- ۱) تلگرام (اجباری) ----------
BOT_TOKEN=
ADMIN_CHAT_ID=

# ---------- ۲) زنجیره ترجمه ----------
# ترتیب اولویت. هر کدام خطا بدهد (کلید باطل، سقف پر، قطعی)
# خودکار می‌رود سراغ بعدی. از چپ به راست.
TRANSLATE_ORDER=llm1,llm2,llm3,gemini,translate

# نکته مهم درباره OpenCode:
# یک کلید داری ولی ده‌ها مدل. پس همان کلید و همان BASE_URL را در چند اسلات
# تکرار کن و فقط MODEL را عوض کن — می‌شود زنجیره fallback بین مدل‌های رایگان.
# برای دیدن نام دقیق مدل‌ها:  python list_models.py llm1

# --- اسلات ۱: OpenCode — مدل اول ---
LLM1_NAME=opencode-deepseek
LLM1_BASE_URL=https://opencode.ai/zen/v1
LLM1_KEY=
LLM1_MODEL=deepseek-v4-flash-free

# --- اسلات ۲: همان کلید OpenCode، مدل دوم (پشتیبان) ---
LLM2_NAME=opencode-ling
LLM2_BASE_URL=https://opencode.ai/zen/v1
LLM2_KEY=
LLM2_MODEL=ling-3.0-flash-free

# --- اسلات ۳: Groq (رایگان و سریع) ---
LLM3_NAME=groq
LLM3_BASE_URL=https://api.groq.com/openai/v1
LLM3_KEY=
LLM3_MODEL=llama-3.3-70b-versatile

# --- اسلات ۴ و ۵ خالی، هر وقت خواستی به TRANSLATE_ORDER اضافه‌شان کن ---
LLM4_NAME=openrouter
LLM4_BASE_URL=https://openrouter.ai/api/v1
LLM4_KEY=
LLM4_MODEL=meta-llama/llama-3.3-70b-instruct:free

LLM5_NAME=
LLM5_BASE_URL=
LLM5_KEY=
LLM5_MODEL=

# --- Gemini (فرمت کلیدش فرق دارد، اسلات جدا دارد) ---
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

# --- آخرین سنگر: مترجم گوگل، بدون کلید و بدون سقف ---
# کیفیت ماشینی است، ولی بهتر از اینکه خبر از دست برود.
# پستی که با این ترجمه شود برچسب ⚠️ می‌گیرد تا ادمین بازبینی کند.
ENABLE_DEEP_TRANSLATOR=true

# ---------- ۳) اختیاری ----------
# اگر بدون پراکسی به اینترنت وصل می‌شوی، خالی بگذار. python doctor.py می‌گوید چه بگذاری.
PROXY=

# manual = ربات فقط نسخه آماده را در همین گروه می‌دهد، ادمین دستی منتشر می‌کند
# auto   = ربات خودش روی کانال می‌فرستد (بعد از اتمام تست)
PUBLISH_MODE=manual
CHANNEL_ID=
CHANNEL_USERNAME=@LiverpooliRani

# منابع
ENABLE_LFC=true
ENABLE_ROMANO=true

# زمان‌بندی
POLL_INTERVAL=60
MAX_ITEMS_PER_CYCLE=5
BOOTSTRAP_SILENT=false
