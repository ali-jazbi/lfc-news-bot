# ============================================================
#  برای تست، فقط بخش ۱ و ۲ را پر کن. بقیه اختیاری است.
# ============================================================

# ---------- ۱) تلگرام (اجباری) ----------
BOT_TOKEN=
ADMIN_CHAT_ID=

# ---------- ۲) زنجیره ترجمه ----------
# ترتیب اولویت. هر کدام خطا بدهد (کلید باطل، سقف پر، قطعی)
# خودکار می‌رود سراغ بعدی. از چپ به راست.
TRANSLATE_ORDER=llm1,llm2,llm3,gemini,translate

# نکته مهم درباره OpenCode:
# یک کلید داری ولی ده‌ها مدل. پس همان کلید و همان BASE_URL را در چند اسلات
# تکرار کن و فقط MODEL را عوض کن — می‌شود زنجیره fallback بین مدل‌های رایگان.
# برای دیدن نام دقیق مدل‌ها:  python list_models.py llm1

# --- اسلات ۱: OpenCode — مدل اول ---
LLM1_NAME=opencode-deepseek
LLM1_BASE_URL=https://opencode.ai/zen/v1
LLM1_KEY=
LLM1_MODEL=deepseek-v4-flash-free

# --- اسلات ۲: همان کلید OpenCode، مدل دوم (پشتیبان) ---
LLM2_NAME=opencode-ling
LLM2_BASE_URL=https://opencode.ai/zen/v1
LLM2_KEY=
LLM2_MODEL=ling-3.0-flash-free

# --- اسلات ۳: Groq (رایگان و سریع) ---
LLM3_NAME=groq
LLM3_BASE_URL=https://api.groq.com/openai/v1
LLM3_KEY=
LLM3_MODEL=llama-3.3-70b-versatile

# --- اسلات ۴ و ۵ خالی، هر وقت خواستی به TRANSLATE_ORDER اضافه‌شان کن ---
LLM4_NAME=openrouter
LLM4_BASE_URL=https://openrouter.ai/api/v1
LLM4_KEY=
LLM4_MODEL=meta-llama/llama-3.3-70b-instruct:free

LLM5_NAME=
LLM5_BASE_URL=
LLM5_KEY=
LLM5_MODEL=

# --- Gemini (فرمت کلیدش فرق دارد، اسلات جدا دارد) ---
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

# --- آخرین سنگر: مترجم گوگل، بدون کلید و بدون سقف ---
# کیفیت ماشینی است، ولی بهتر از اینکه خبر از دست برود.
# پستی که با این ترجمه شود برچسب ⚠️ می‌گیرد تا ادمین بازبینی کند.
ENABLE_DEEP_TRANSLATOR=true

# ---------- ۳) اختیاری ----------
# اگر بدون پراکسی به اینترنت وصل می‌شوی، خالی بگذار. python doctor.py می‌گوید چه بگذاری.
PROXY=

# manual = ربات فقط نسخه آماده را در همین گروه می‌دهد، ادمین دستی منتشر می‌کند
# auto   = ربات خودش روی کانال می‌فرستد (بعد از اتمام تست)
PUBLISH_MODE=manual
CHANNEL_ID=
CHANNEL_USERNAME=@LiverpooliRani

# منابع
ENABLE_LFC=true
ENABLE_ROMANO=true

# حالت جمع‌آوری توییتر:
#   fxembed = FxEmbed/FxTwitter API v2 — رایگان، بدون کلید/کوکی/لاگین ← توصیه‌شده
#   classic = آینه‌های نیتر (legacy — آینه‌ها مرده‌اند، فقط سازگاری)
#   xscrape = اسکرپ مستقیم x.com (از سپتامبر ۲۰۲۶ x.com دیگر relay data در HTML
#             نمی‌گذارد → عملاً مرده؛ برای سازگاری نگه داشته شده)
TWITTER_MODE=fxembed

# --- FxEmbed / FxTwitter (منبع توصیه‌شده) ---
FXEMBED_BASE=https://api.fxtwitter.com
FXEMBED_TIMEOUT=20
# این API گاهی اتصال را نیمه‌کاره می‌بندد → چند تلاش لازم است
FXEMBED_FETCH_TRIES=3
# چند توییت آخر هر حساب خوانده شود (سقف API: ۱۰۰)
FXEMBED_TWEETS_PER_ACCOUNT=20
# سقف صفحه‌های cursor در polling افزایشی: اگر در پنجره‌ی since بیش از یک صفحه
# پست جمع شده باشد (مثلاً بعد از downtime) ادامه می‌دهیم تا خبری گم نشود.
# سقف سخت = FXEMBED_TWEETS_PER_ACCOUNT × FXEMBED_MAX_PAGES
FXEMBED_MAX_PAGES=3
# چند حساب همزمان خوانده شود — این تنها throttle واقعی است.
# سقف نرخ مستندشده‌ی API v2: ۱۰۰۰ درخواست در دقیقه به‌ازای هر IP (ما ~۳۰/سیکل)
FXEMBED_WORKERS=6
# Empty/unavailable accounts remain eligible for their next normal polling cycle.
# حساب‌هایی که توییت اصلی ندارند در timeline پیش‌فرض ۴۰۴ می‌دهند → یک بار با
# with_replies=1 خوانده می‌شوند و به توییت‌های خودشان محدود می‌شوند
FXEMBED_WITH_REPLIES_FALLBACK=true
# polling افزایشی (کد 204 = خبر تازه نیست) + حاشیه‌ی زمانی برای «گم نشدن خبر»
FXEMBED_USE_SINCE=true
FXEMBED_SINCE_OVERLAP_SECONDS=900

# اگر x.com چند سیکل پشت‌هم جواب نداد (بلاک IP دیتاسنتر و...) برگرده به نیتر؟
# ⚠ classic/Nitter دیگر منبع قابل اتکایی نیست؛ این fallback فقط «ادامه دادن
# بدون خطا» است. راه‌حل واقعی: TWITTER_MODE=fxembed
XSCRAPE_FALLBACK_CLASSIC=true
XSCRAPE_MAX_CONSECUTIVE_DEAD_CYCLES=3
XSCRAPE_TIMEOUT=20
XSCRAPE_TWEETS_PER_ACCOUNT=8
# در هر سیکل چند توییت آخر هر حساب چک شود (قبلاً ۳ هاردکد بود و در روزهای
# پرتوییت توییت تازه گم می‌شد). پیش‌فرض ۸ = همان XSCRAPE_TWEETS_PER_ACCOUNT.
TWEETS_CHECKED_PER_ACCOUNT_PER_CYCLE=8

# سقف ویدیوهای forward چندتایی (اگر یک توییت چند ویدیو داشته باشد) — پیش‌فرض ۴
TWITTER_VIDEO_MAX=4

# تست @twittervid_bot (اختیاری — هنوز پیاده نشده؛ اسکلت: scripts/manual_tests/test_twittervid_bot.py)
TWITTERVID_API_ID=
TWITTERVID_API_HASH=
TWITTERVID_SESSION=

# زمان‌بندی
POLL_INTERVAL=60
MAX_ITEMS_PER_CYCLE=5
BOOTSTRAP_SILENT=false

# ---------- ۴) Hermes AI Editor (اختیاری) ----------
# روشن کردن = خبر قبل از ترجمه از لایه تحلیل/راستی‌آزمایی/QC عبور می‌کند.
# خاموش (پیش‌فرض) = رفتار قبلی بات دقیقاً حفظ می‌شود.
# هرمس فقط مغز سردبیری است؛ Python همچنان backend است.
HERMES_ENABLED=false

# مسیر باینری hermes (روی ویندوز: %LOCALAPPDATA%/hermes/hermes-agent/venv/Scripts/hermes.exe)
# خالی = خودکار (PATH یا HERMES_HOME استاندارد)
HERMES_BIN=
HERMES_HOME=
HERMES_TIMEOUT=150        # سقف هر فراخوانی agent (ثانیه)
HERMES_RETRIES=1          # تلاش مجدد روی خطای provider
HERMES_TOOLSETS=web,vision,file,terminal
HERMES_MAX_REVISIONS=2    # سقف اصلاح ترجمه (بعد از آن → human_review)
AI_IMPORTANCE_HIGH=7      # اهمیت ≥ این → مسیر پرهزینه (verification)
AI_ALWAYS_ANALYZE=false   # همه خبرها حتی tier پایین تحلیل شوند؟
MAX_SEND_RETRIES=3        # شکست ارسال → retry_pending تا این سقف، بعد failed
IMAGE_MIN_CONFIDENCE=0.6  # حداقل اطمینان عکس — پایین‌تر = بدون عکس

# نصب یکپارچگی هرمس (skills + MCP):  python install_hermes.py

# --- منابع RSS جدید (اختیاری) ---
# خالی = هیچ منبع جدیدی فعال نیست (رفتار قبلی). شناسه‌های معتبر:
#   football365, liverpoolcom, guardian, thisisanfield   (یا all)
# هر خبر مثل بقیه‌ی منابع به گروه ادمین می‌رود و نام منبع پایینش می‌آید.
# فید BBC و OUTLET_RSS_FEEDS جدا هستند و با این تنظیم تغییر نمی‌کنند.
OUTLET_RSS_SOURCES=all
# پنجرهٔ گزارش خبرهای جاافتاده؛ خبر ذخیره‌شده در صف به‌دلیل سن حذف نمی‌شود.
OUTLET_RSS_MAX_AGE_HOURS=12
ENABLE_NEWS_SEARCH=true
NEWS_SEARCH_INTERVAL=300

# Persistent ingestion; processing capacity is independent of received batch size.
FETCH_ITEMS_PER_SOURCE=100
TRANSLATION_QC_ENABLED=true
ENABLE_DEEP_TRANSLATOR=true
MAX_SEND_RETRIES=3
